[Unit]
Description=SAHAASRA billing software
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=sahaasra
Group=sahaasra
WorkingDirectory=/srv/sahaasra/app/backend
EnvironmentFile=/srv/sahaasra/shared/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# Hardening: the app can only write to its uploads folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sahaasra/shared/uploads

[Install]
WantedBy=multi-user.target
