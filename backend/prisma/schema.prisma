// SAHAASRA database schema (PostgreSQL).
// Every business-owned row carries tenantId; the API scopes all queries by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Platform ─────────────

model Tenant {
  id            String    @id @default(cuid())
  name          String
  legalName     String?
  type          String // restaurant | hotel | salon | grocery | stationery | mobile | pharmacy | jewellery | clothing | hardware | other (legacy: retail, service, wholesale)
  gstin         String?
  pan           String?
  businessPhone String?
  businessEmail String?
  website       String?
  addressLine   String?
  city          String    @default("")
  state         String?
  pincode       String?
  location      Json? // { latitude, longitude, altitude, accuracy, capturedAt, source }
  ownerName     String
  ownerEmail    String
  ownerPhone    String
  ownerAltPhone String?
  ownerPan      String?
  access        Json? // string[] of page ids; null = all pages
  notes         String?
  plan          String    @default("trial")
  status        String    @default("trial") // active | trial | suspended | churned
  mrr           Decimal   @default(0) @db.Decimal(12, 2)
  trialEndsAt   DateTime?
  /// When true, this business is under Astron Labs digital marketing services (free billing).
  astronLabsService Boolean @default(false)
  /// Start of plan/service validity.
  planValidFrom DateTime?
  /// End of plan/service validity — billing becomes due after this date.
  planValidTo   DateTime?
  /// Created from the public sign-up page: the Build plan must be paid before the software can be used.
  selfSignup    Boolean   @default(false)
  /// Billing period of the last plan bought online: monthly | quarterly | yearly
  planPeriod    String?
  logoUploadId  String?
  settings      Json      @default("{}")
  invoiceSeq    Int       @default(0)
  orderSeq      Int       @default(0)
  kotSeq        Int       @default(0)
  repairSeq     Int       @default(0)
  employeeSeq   Int       @default(0)
  returnSeq     Int       @default(0)
  skuSeq        Int       @default(0)
  jobSeq        Int       @default(0)
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users            User[]
  roles            Role[]
  products         Product[]
  services         ServiceItem[]
  packages         Package[]
  serials          ProductSerial[]
  jobCards         JobCard[]
  customers        Customer[]
  vendors          Vendor[]
  sales            Sale[]
  purchases        Purchase[]
  payments         Payment[]
  returns          ReturnRecord[]
  expenses         Expense[]
  employees        Employee[]
  attendance       Attendance[]
  advances         Advance[]
  payrollRuns      PayrollRun[]
  stockMovements   StockMovement[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  tables           RestaurantTable[]
  orders           RestaurantOrder[]
  kots             Kot[]
  rooms            Room[]
  reservations     Reservation[]
  appointments     Appointment[]
  metalRates       MetalRate[]
  jewelleryItems   JewelleryItem[]
  repairs          RepairJob[]
  medicines        Medicine[]
  tickets          Ticket[]
  billTemplates    BillTemplate[]
  heldBills        HeldBill[]
  uploads          Upload[]
  customerNotes    CustomerNote[]
  referrals        Referral[]
  vaahakLink       VaahakLink?
  billMessages     BillMessage[]
  planPayments     PlanPayment[]

  @@index([status])
  @@index([createdAt])
}

/// A business this tenant referred to Sahaasra. The Sahaasra team follows up and grants the reward.
model Referral {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referredBy   String // name of the user who sent it
  businessName String
  contactName  String
  phone        String
  city         String   @default("")
  businessType String?
  notes        String?
  status       String   @default("new") // new | contacted | joined | rewarded | declined
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique // stored lower-case
  phone        String? // display form
  phoneKey     String?   @unique // last 10 digits, for mobile sign-in
  passwordHash String
  role         String // "Super Admin" or a tenant role name
  branch       String    @default("All Branches")
  status       String    @default("active") // active | invited | suspended
  preferences  Json      @default("{}")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]

  @@index([tenantId])
}

model Session {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonateTenantId String?
  userAgent           String?
  ip                  String?
  createdAt           DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  expiresAt           DateTime

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  system      Boolean  @default(false)
  permissions Json     @default("{}") // { [module]: Permission[] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

model Ticket {
  id          String          @id @default(cuid())
  seq         Int             @unique @default(autoincrement())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterId String?
  requester   String
  email       String
  subject     String
  category    String
  priority    String
  status      String          @default("open")
  assignee    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())
  messages    TicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model TicketMessage {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  from     String // customer | agent | note
  author   String
  text     String
  at       DateTime @default(now())

  @@index([ticketId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     String
  action   String
  module   String
  target   String
  details  String   @default("")
  ip       String   @default("")
  at       DateTime @default(now())

  @@index([tenantId, at])
}

model Upload {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())
}

// ───────────── Catalogue & parties ─────────────

model Product {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  sku           String
  barcode       String    @default("")
  category      String
  brand         String    @default("")
  unit          String    @default("Pcs")
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal   @default(0) @db.Decimal(12, 2)
  mrp           Decimal   @default(0) @db.Decimal(12, 2)
  gstRate       Decimal   @default(0) @db.Decimal(5, 2)
  hsn           String    @default("")
  /// In the product's base unit; decimals allowed for items sold loose (kg, metre).
  stock         Decimal   @default(0) @db.Decimal(14, 3)
  minStock      Decimal   @default(0) @db.Decimal(14, 3)
  supplier      String    @default("")
  status        String    @default("active")
  expiryDate    DateTime?
  warehouse     String    @default("Main Store")
  /// When true, this is a self-made/kitchen product (e.g., Biriyani) that doesn't need stock tracking.
  isSelfProduct Boolean   @default(false)
  /// "self" = self product (made in-house); "outsider" = vendor/procured product (tracks inventory)
  productType   String    @default("outsider")
  /// Industry-specific details (veg mark, IMEI tracking, composition, ISBN, size, colour...).
  attributes    Json      @default("{}")
  /// Ways to sell: [{ name, price, factor }] e.g. Half / Full, Box of 10 (factor = base units used).
  options       Json      @default("[]")
  /// Extras added on a line: [{ name, price }] e.g. extra cheese.
  addons        Json      @default("[]")
  /// Contractor / wholesale price (0 = same as selling price).
  tradePrice    Decimal   @default(0) @db.Decimal(12, 2)
  /// Can be sold in fractions (1.5 kg, 2.25 m).
  allowDecimalQty Boolean @default(false)
  /// Products created together as size / colour variants share this id.
  variantGroup  String?
  /// Photo: "/api/uploads/<id>" (uploaded) or "/dishes/<key>.svg" (built-in picture), "" for none.
  image         String    @default("")
  /// Marked out of stock by hand (e.g. a dish finished for the day); can't be sold until turned off.
  soldOut       Boolean   @default(false)
  /// Used inside the business (salon shampoo, wax), never sold; services draw it down as they're billed.
  inHouse       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model ServiceItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  category      String
  price         Decimal  @db.Decimal(12, 2)
  durationMins  Int      @default(30)
  gstRate       Decimal  @default(18) @db.Decimal(5, 2)
  staff         Json     @default("[]")
  commissionPct Decimal  @default(0) @db.Decimal(5, 2)
  status        String   @default("active")
  sac           String   @default("")
  /// What the price is for: service, page, plate, day, visit, hour, point...
  priceUnit     String   @default("service")
  attributes    Json     @default("{}")
  /// Uploaded photo (/api/uploads/<id>) or a built-in picture (/salon/<key>.svg).
  image         String   @default("")
  /// In-house products used each time: [{ productId, qty }] in the product's unit.
  consumables   Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

/// A bundle of products and/or services sold at one price (combo, kit, package).
model Package {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("Packages")
  description  String   @default("")
  /// Price before GST (like every other catalogue price).
  price        Decimal  @db.Decimal(12, 2)
  /// [{ kind: 'product' | 'service', refId, name, qty }]
  items        Json     @default("[]")
  validityDays Int?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Customer {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String         @default("")
  city         String         @default("")
  gstin        String?
  orders       Int            @default(0)
  totalSpend   Decimal        @default(0) @db.Decimal(14, 2)
  outstanding  Decimal        @default(0) @db.Decimal(14, 2)
  dueDate      DateTime?
  lastPurchase DateTime?
  tags         Json           @default("[]")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  notes        CustomerNote[]

  @@index([tenantId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  text       String
  author     String
  createdAt  DateTime @default(now())
}

model Vendor {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  contact        String    @default("")
  phone          String
  email          String    @default("")
  city           String    @default("")
  gstin          String    @default("")
  category       String    @default("General")
  purchases      Int       @default(0)
  totalPurchased Decimal   @default(0) @db.Decimal(14, 2)
  payable        Decimal   @default(0) @db.Decimal(14, 2)
  dueDate        DateTime?
  lastPurchase   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

// ───────────── Transactions ─────────────

model Sale {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNo    String
  customerId   String?
  customerName String
  date         DateTime   @default(now())
  branch       String     @default("Main Branch")
  subtotal     Decimal    @db.Decimal(14, 2)
  discount     Decimal    @default(0) @db.Decimal(14, 2)
  tax          Decimal    @default(0) @db.Decimal(14, 2)
  total        Decimal    @db.Decimal(14, 2)
  paid         Decimal    @default(0) @db.Decimal(14, 2)
  payment      String
  status       String
  cashier      String
  notes        String?
  /// Seller details as printed on the day (name, address, GSTIN, logo, UPI, bank, template) so re-downloads match.
  seller       Json?
  items        SaleItem[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  serviceId String?
  /// IMEI / serial numbers sold on this line.
  serials     Json    @default("[]")
  /// Set on every part of a package sold as one line.
  packageId   String?
  packageName String  @default("")
  name      String
  sku       String  @default("")
  hsn       String  @default("")
  qty       Decimal @db.Decimal(14, 3)
  /// Base units taken out of stock (qty x option factor); 0 for untracked items.
  stockQty  Decimal @default(0) @db.Decimal(14, 3)
  rate      Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  cost      Decimal @default(0) @db.Decimal(12, 2) // cost per unit sold at the time of sale (x option factor)
  /// Who did this service (salon staff); the name is kept even if the employee is removed later.
  staffId   String?
  staff     String  @default("")

  @@index([saleId])
}

model Purchase {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNo        String
  vendorId      String
  vendorName    String
  date          DateTime
  subtotal      Decimal        @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  tax           Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @db.Decimal(14, 2)
  paid          Decimal        @default(0) @db.Decimal(14, 2)
  status        String
  paymentStatus String
  notes         String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]

  @@index([tenantId, date])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String?
  name       String
  sku        String   @default("")
  hsn        String   @default("")
  qty        Decimal  @db.Decimal(14, 3)
  rate       Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2)

  @@index([purchaseId])
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction  String // in (from customer) | out (to vendor)
  customerId String?
  vendorId   String?
  saleId     String?
  purchaseId String?
  amount     Decimal  @db.Decimal(14, 2)
  method     String
  reference  String   @default("")
  date       DateTime @default(now())
  createdBy  String   @default("")

  @@index([tenantId, date])
}

model ReturnRecord {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind     String // sale | purchase
  ref      String
  against  String
  party    String
  date     DateTime @default(now())
  amount   Decimal  @db.Decimal(14, 2)
  tax      Decimal  @default(0) @db.Decimal(14, 2)
  reason   String
  status   String   @default("approved")

  @@index([tenantId, kind])
}

model Expense {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  category         String
  amount           Decimal  @db.Decimal(14, 2)
  date             DateTime
  paidTo           String
  method           String
  status           String   @default("paid")
  recurring        Boolean  @default(false)
  notes            String?
  receiptUploadId  String?
  receiptName      String?
  createdAt        DateTime @default(now())

  @@index([tenantId, date])
}

model StockMovement {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  productId String?
  product   String
  sku       String   @default("")
  type      String // in | out | adjustment | transfer
  qty       Decimal  @db.Decimal(14, 3)
  reference String   @default("")
  warehouse String   @default("Main Store")
  by        String   @default("")
  /// Supplier of stock added (optional); the name is kept even if the vendor is deleted later.
  vendorId  String?
  vendor    String   @default("")

  @@index([tenantId, date])
  @@index([tenantId, vendorId])
}

// ───────────── People ─────────────

model Employee {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  phone       String
  email       String       @default("")
  designation String
  department  String
  branch      String       @default("Main Branch")
  joinDate    DateTime
  salary      Decimal      @db.Decimal(12, 2)
  status      String       @default("active")
  dob         DateTime?
  address     String       @default("")
  bloodGroup  String       @default("")
  pan         String       @default("")
  bank        String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendance  Attendance[]
  advances    Advance[]

  @@index([tenantId])
}

model Attendance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  status     String

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

model Advance {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  recovered       Decimal  @default(0) @db.Decimal(12, 2)
  monthlyRecovery Decimal  @db.Decimal(12, 2)
  reason          String
  date            DateTime @default(now())

  @@index([tenantId])
}

model PayrollRun {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month     String // yyyy-MM
  entries   Json
  total     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@unique([tenantId, month])
}

// ───────────── Industry modules ─────────────

model RestaurantTable {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String
  seats       Int
  area        String
  status      String    @default("available")
  guests      Int?
  waiter      String?
  openedAt    DateTime?
  orderId     String?
  mergedWith  Json?
  reservedFor String?

  @@unique([tenantId, label])
}


model RestaurantOrder {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String
  type      String
  tableId   String?
  customer  String?
  lines     Json     @default("[]")
  status    String   @default("open")
  saleId    String?
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model Kot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String
  orderId   String
  table     String
  type      String
  items     Json
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model Room {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number   String
  floor    Int
  type     String
  rate     Decimal   @db.Decimal(10, 2)
  status   String    @default("available")
  guest    String?
  checkOut DateTime?

  @@unique([tenantId, number])
}

model Reservation {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String
  guest      String
  phone      String
  roomNumber String
  roomType   String
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  amount     Decimal  @db.Decimal(12, 2)
  advance    Decimal  @default(0) @db.Decimal(12, 2)
  source     String
  status     String   @default("confirmed")
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Appointment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     String
  phone        String
  service      String
  staff        String
  start        DateTime
  durationMins Int
  price        Decimal  @db.Decimal(10, 2)
  status       String   @default("booked")
  createdAt    DateTime @default(now())

  @@index([tenantId, start])
}

model MetalRate {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String
  metal       String
  purity      String
  ratePerGram Decimal @default(0) @db.Decimal(10, 2)
  change      Decimal @default(0) @db.Decimal(6, 2)

  @@unique([tenantId, metal, purity])
}

model JewelleryItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  sku           String
  metal         String
  purity        String
  grossWeight   Decimal  @db.Decimal(10, 3)
  netWeight     Decimal  @db.Decimal(10, 3)
  makingPerGram Decimal  @default(0) @db.Decimal(10, 2)
  stoneValue    Decimal  @default(0) @db.Decimal(12, 2)
  huid          String   @default("—")
  category      String
  status        String   @default("in-stock")
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model RepairJob {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket   String
  customer String
  item     String
  work     String
  received DateTime @default(now())
  promised DateTime
  estimate Decimal  @default(0) @db.Decimal(10, 2)
  status   String   @default("received")

  @@index([tenantId])
}

model Medicine {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  generic      String
  manufacturer String
  batch        String
  expiry       DateTime
  schedule     String
  pack         String
  stock        Int      @default(0)
  minStock     Int      @default(0)
  mrp          Decimal  @db.Decimal(10, 2)
  rate         Decimal  @db.Decimal(10, 2)
  gstRate      Decimal  @default(12) @db.Decimal(5, 2)
  rack         String   @default("")
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// ───────────── Workspace tools ─────────────

model BillTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Template id as the web app knows it (unique per business; presets share ids across businesses).
  key       String
  name      String
  paper     String
  accent    String
  font      String
  watermark String   @default("")
  elements  Json
  isDefault Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model HeldBill {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  label    String
  state    Json
  heldAt   DateTime @default(now())

  @@index([tenantId])
}

/// One physical unit of an IMEI / serial-tracked product.
model ProductSerial {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  serial        String
  /// in_stock | sold | removed
  status        String    @default("in_stock")
  saleId        String?
  invoiceNo     String?
  customerName  String?
  soldAt        DateTime?
  warrantyUntil DateTime?
  purchaseId    String?
  note          String    @default("")
  createdAt     DateTime  @default(now())

  @@unique([tenantId, serial])
  @@index([tenantId, productId, status])
}

/// A repair, tailoring or custom-work order from receipt to delivery.
model JobCard {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String
  /// repair | tailoring | custom | service
  kind         String    @default("repair")
  customerId   String?
  customerName String
  phone        String    @default("")
  /// Device, garment or article received.
  item         String
  /// IMEI / serial number when relevant.
  identifier   String    @default("")
  problem      String    @default("")
  /// Measurements, accessories received, condition… as label → value.
  details      Json      @default("{}")
  estimate     Decimal   @default(0) @db.Decimal(12, 2)
  advance      Decimal   @default(0) @db.Decimal(12, 2)
  advanceMethod String?
  /// received | in_progress | ready | delivered | cancelled
  status       String    @default("received")
  assignedTo   String    @default("")
  promisedAt   DateTime?
  /// Parts and labour to bill: [{ kind: 'product' | 'service' | 'custom', refId?, name, qty, rate?, gstRate? }]
  lines        Json      @default("[]")
  saleId       String?
  invoiceNo    String?
  deliveredAt  DateTime?
  notes        String    @default("")
  createdBy    String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

// ════════ E-billing (WhatsApp bills sent through VAAHAK) ════════

/// The business's VAAHAK account: bills are sent on its WhatsApp number and paid from its VAAHAK wallet.
model VaahakLink {
  tenantId     String   @id
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId    String
  /// VAAHAK connection key, AES-256-GCM encrypted. Never sent to the browser.
  keyEnc       String
  keyPrefix    String   @default("")
  businessName String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The WhatsApp thank-you message for one bill (at most one per bill).
model BillMessage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId      String   @unique
  invoiceNo   String
  customer    String   @default("")
  to          String
  /// sending | sent | failed | skipped
  status      String
  /// WhatsApp delivery: sent | delivered | read | failed (from VAAHAK)
  delivery    String?
  waMessageId String?
  error       String?
  /// Deducted from the VAAHAK wallet.
  charged     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ════════ Subscription payments (PayU hosted checkout) ════════

/// One attempt to buy a plan. The plan is extended only after PayU's verify API confirms the payment.
model PlanPayment {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Our PayU transaction id (unique).
  txnid     String    @unique
  plan      String
  /// monthly | quarterly | yearly
  period    String
  amount    Decimal   @db.Decimal(12, 2)
  /// pending | success | failed
  status    String    @default("pending")
  mihpayid  String?
  mode      String?
  error     String?
  /// Plan validity this payment added.
  validFrom DateTime?
  validTo   DateTime?
  paidAt    DateTime?
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, createdAt])
}