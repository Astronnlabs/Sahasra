# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection for the dedicated "sahasra" database user.
DATABASE_URL="postgresql://sahasra:CHANGE_ME@127.0.0.1:5432/sahasra?schema=public"
PORT=4000
NODE_ENV=development
# Origin of the web app (informational; the app and API are served from the same origin)
APP_ORIGIN=http://localhost:5173
# Where uploaded files (receipts, logos) are stored
UPLOAD_DIR=./uploads

# ── E-billing (bills sent on WhatsApp through VAAHAK, paid from the VAAHAK wallet) ──
# 32 random bytes, base64. Encrypts each business's VAAHAK connection key. Never change it once keys are saved.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
VAAHAK_API_URL=https://vaahak.onrender.com

# -- Plan purchases (PayU hosted checkout) --
# PayU merchant key and salt. live = real money, test = PayU sandbox. Server only, never in the web app.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=live
# Public https address of this server as PayU reaches it. Empty = APP_ORIGIN.
# PayU returns to {PUBLIC_URL}/api/payments/payu/return.
PUBLIC_URL=
