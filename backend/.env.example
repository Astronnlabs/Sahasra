# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection for the dedicated "sahasra" database user.
DATABASE_URL="postgresql://sahasra:CHANGE_ME@127.0.0.1:5432/sahasra?schema=public"
PORT=4000
NODE_ENV=development
# Origin of the web app (informational; the app and API are served from the same origin)
APP_ORIGIN=http://localhost:5173
# Where uploaded files (receipts, logos) are stored
UPLOAD_DIR=./uploads

# ── E-billing (WhatsApp bills) & wallet ──
# 32 random bytes, base64. Encrypts each business's WhatsApp token. Never change it once tokens are saved.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Wallet deduction per bill sent on WhatsApp (₹)
EBILL_PRICE=0.25
# PayU merchant key and salt (wallet recharge). live = real money, test = PayU sandbox.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=live
