# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection for the dedicated "sahasra" database user.
DATABASE_URL="postgresql://sahasra:CHANGE_ME@127.0.0.1:5432/sahasra?schema=public"
PORT=4000
NODE_ENV=development
# Origin of the web app (informational; the app and API are served from the same origin)
APP_ORIGIN=http://localhost:5173
# Where uploaded files (receipts, logos) are stored
UPLOAD_DIR=./uploads
